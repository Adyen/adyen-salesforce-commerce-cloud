{
  "name": "adyen_salesforce_e2e_tests",
  "version": "1.0.0",
  "description": "e2e tests for Adyen SalesForce Cartridges",
  "main": "index.js",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "scripts": {
    "test": "pnpm exec playwright test",
    "test:ci": "pnpm exec playwright test --project=chromium --config=sfcc.config.js",
    "test:ci:quick": "pnpm exec playwright test --project=chromium --config=sfcc.config.js -g @quick"
  }
}
