{
  "name": "adyen_salesforce_e2e_tests",
  "version": "1.0.0",
  "description": "e2e tests for Adyen SalesForce Cartridges",
  "main": "index.js",
  "dependencies": {
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1"
  },
  "scripts": {
    "test": "npx playwright test",
