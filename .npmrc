# sgmf-scripts runs `node <node_modules/.bin/dwupload>` to upload cartridges, which
# only works when .bin entries are symlinks to the target JS file. pnpm's default
# isolated linker writes /bin/sh shims there instead, so node parses shell script as
# JavaScript and uploadCartridge dies with a SyntaxError. The hoisted linker restores
# npm's symlinked layout. Note that shamefully-hoist does not help: it changes where
# packages are placed, not the .bin entry format.
node-linker=hoisted
