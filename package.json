{
  "name": "app_adyen_SFRA",
  "version": "26.4.0",
  "description": "Adyen's official cartridge for SFRA",
  "main": "index.js",
  "paths": {
    "base": "../storefront-reference-architecture/cartridges/app_storefront_base/",
    "int_adyen_SFRA": "./cartridges/int_adyen_SFRA"
  },
  "scripts": {
    "unitTest": "sgmf-scripts --test cartridges/int_adyen_SFRA/test/unit/**/*.js",
    "lint": "eslint --ext js src",
    "lint:fix": "eslint --ext js --fix src",
    "format": "prettier-eslint $PWD/src/**/*.js",
    "upload": "sgmf-scripts --upload -- ",
    "uploadCartridge": "sgmf-scripts --uploadCartridge int_adyen_SFRA && sgmf-scripts --uploadCartridge app_adyen_SFRA && sgmf-scripts --uploadCartridge bm_adyen && sgmf-scripts --uploadCartridge int_adyen_webhooks",
    "watch": "sgmf-scripts --watch",
    "compile:js": "sgmf-scripts --compile js",
    "transpile": "babel ./src/cartridges -d ./cartridges --delete-dir-on-start --copy-files --no-copy-ignored --extensions .js,.test.js,.snap",
    "build": "pnpm run transpile && pnpm run compile:js && pnpm run uploadCartridge",
    "test": "jest ./src",
    "test:watch": "jest ./src --watch",
    "test:coverage": "jest ./src --coverage",
    "test:coverageHTML": "jest ./src --coverage --coverageDirectory='coverage'",
    "check-build:sfra": "chmod 755 ./check-build.sh && sh ./check-build.sh SFRA",
    "check-branch-name": "chmod 755 ./branching.sh && sh ./branching.sh",
    "check-logs": "node check-logs",
    "prepare": "husky install",
    "init:isml": "./node_modules/.bin/isml-linter --init",
    "lint:isml": "./node_modules/.bin/isml-linter",
    "build:isml": "./node_modules/.bin/isml-linter --build",
    "fix:isml": "./node_modules/.bin/isml-linter --autofix"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=18.12"
  },
  "dependencies": {
    "mobx": "^6.16.1",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/jest": "^29.5.14",
    "babel-loader": "^9.2.1",
    "chai": "^4.5.0",
    "css-loader": "^6.11.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-formatter-pretty": "^6.0.1",
    "eslint-formatter-summary": "^1.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^8.0.3",
    "isml-linter": "^5.43.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jquery": "^3.7.1",
    "mocha": "^10.8.2",
    "postcss-loader": "^7.3.4",
    "prettier": "^3.9.8",
    "proxyquire": "2.1.3",
    "regenerator-runtime": "^0.13.11",
    "resolve-url-loader": "^5.0.0",
    "sgmf-scripts": "^4.0.0",
    "sinon": "^15.2.0",
    "style-loader": "^3.3.4",
    "stylelint": "^15.11.0",
    "stylelint-scss": "^4.7.0",
    "webpack": "^5.111.1"
  },
  "pnpm": {
    "overrides": {
      "minimist": "1.2.8",
      "node-notifier": "10.0.1",
      "minimatch": "7.4.9",
      "glob-parent": "6.0.2",
      "yargs-parser": "21.1.1",
      "braces": "3.0.3",
      "jszip": "3.10.2",
      "merge": "2.1.1",
      "got": "12.6.1",
      "get-func-name": "3.0.0",
      "tough-cookie": "4.1.4",
      "form-data": "4.0.6",
      "tmp": "0.2.7",
      "uuid": "11.1.1",
      "serialize-javascript": "7.0.5",
      "mocha>diff": "9.0.0"
    }
  }
}
